{
  "name": "typst",
  "version": "1.1.0",
  "api": 1,
  "code": "typst.wasm",
  "views": [{ "name": "pages", "title": "Pages", "shows": "pages", "place": "tab", "key": "space v" }],
  "extensions": ["typ"],
  "comment": "//",
  "pairs": ["$$"],
  "server": ["tinymist"],
  "highlights": true,
  "access": {
    "project": true,
    "fonts": true,
    "cache": true,
    "read": ["{data}/typst/packages"],
    "write": ["{cache}/typst/packages"],
    "network": ["packages.typst.org"],
    "memory_mb": 4096,
    "seconds": 120
  }
}
